
CREATE TABLE UserTable (
  -- 主键ID（自增）
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  -- 用户唯一标识
  user_id TEXT NOT NULL UNIQUE,
  -- 用户名
  username TEXT NOT NULL,
  -- 用户昵称
  nickname TEXT,
  -- 手机号码
  phone TEXT,
  -- 邮箱地址
  email TEXT,
  -- 用户头像URL
  avatar TEXT,
  -- 背景图URL
  background TEXT,
  -- 性别（0-未知，1-男，2-女）
  gender INTEGER DEFAULT 0,
  -- 生日
  birthday TEXT,
  -- 个人简介（签名）
  signature TEXT,
  -- 用户状态（0-正常，1-禁用，2-锁定）
  status INTEGER DEFAULT 0,
  -- 是否在线
  is_online INTEGER DEFAULT 0,
  -- 最后登录时间（时间戳）
  last_login_time INTEGER,
  -- 最后登录IP
  last_login_ip TEXT,
  -- 创建时间（时间戳）
  create_time INTEGER NOT NULL,
  -- 更新时间（时间戳）
  update_time INTEGER NOT NULL
);

insertUser:
INSERT INTO UserTable (
  user_id,        -- 用户唯一标识
  username,       -- 用户名
  nickname,       -- 用户昵称
  phone,          -- 手机号码
  email,          -- 邮箱地址
  avatar,         -- 用户头像URL
  background,     -- 背景图URL
  gender,         -- 性别（0-未知，1-男，2-女）
  birthday,       -- 生日
  signature,      -- 个人简介（签名）
  status,         -- 用户状态（0-正常，1-禁用，2-锁定）
  is_online,      -- 是否在线
  last_login_time,-- 最后登录时间（时间戳）
  last_login_ip,  -- 最后登录IP
  create_time,    -- 创建时间（时间戳）
  update_time     -- 更新时间（时间戳）
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

removeUser:
DELETE FROM UserTable WHERE user_id = ?;

updateUser:
UPDATE UserTable
SET
  username = ?,       -- 用户名
  nickname = ?,       -- 用户昵称
  phone = ?,          -- 手机号码
  email = ?,          -- 邮箱地址
  avatar = ?,         -- 用户头像URL
  background = ?,     -- 背景图URL
  gender = ?,         -- 性别
  birthday = ?,       -- 生日
  signature = ?,      -- 个人简介（签名）
  status = ?,         -- 用户状态
  is_online = ?,      -- 是否在线
  last_login_time = ?,-- 最后登录时间（时间戳）
  last_login_ip = ?,  -- 最后登录IP
  update_time = ?     -- 更新时间（时间戳）
WHERE
  user_id = ?;        -- 定位唯一用户

-- 查询单个用户
selectUserByUserId:
SELECT
  user_id, username, nickname, phone, email, avatar, background,
  gender, birthday, signature, status, is_online, last_login_time,
  last_login_ip, create_time, update_time
FROM UserTable
WHERE user_id = ?;

selectUser:
SELECT * FROM UserTable;
