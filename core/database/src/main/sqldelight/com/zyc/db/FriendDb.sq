-- 好友信息表：存储所有好友的基本资料、状态及关联信息
CREATE TABLE FriendTable (
  -- 主键ID（自增）：唯一标识一条好友记录，无需手动插入
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  -- 用户唯一标识：好友的系统内唯一ID（如用户UUID），关联用户表
  user_id TEXT NOT NULL,
  -- 用户名：好友的用户名
  username TEXT NOT NULL,
  -- 用户昵称：好友的显示名称，用于界面展示
  nickname TEXT,
  -- 手机号码：好友的联系电话，可为空（用户可能未提供）
  phone TEXT,
  -- 邮箱地址：好友的电子邮箱，可为空
  email TEXT,
  -- 用户头像URL：好友头像的网络地址，用于显示头像图片
  avatar TEXT,
  -- 背景图URL：好友个人主页背景图的网络地址，可为空
  background TEXT,
  -- 性别：0-未知，1-男，2-女，用数字枚举表示
  gender INTEGER DEFAULT 0,
  -- 生日：好友的出生日期，格式通常为"yyyy-MM-dd"
  birthday TEXT,
  -- 是否正在聊天：0-不在聊天状态，1-正在聊天中，用于标记会话状态
  is_chat INTEGER DEFAULT 0,
  -- 个人简介：好友的自我介绍内容，可为空
  signature TEXT,
  -- 用户状态：0-正常，1-禁用，2-锁定，标记账号状态
  status INTEGER DEFAULT 0,
  -- 是否在线
  is_online INTEGER DEFAULT 0,
  -- 最后登录时间：好友最近一次登录系统的时间，存储为时间戳
  last_login_time INTEGER,
  -- 最后登录IP：好友最近一次登录使用的IP地址
  last_login_ip TEXT,
  -- 创建时间：该好友记录添加到系统的时间（时间戳）
  create_time INTEGER NOT NULL,
  -- 更新时间：该好友记录最后一次修改的时间（时间戳）
  update_time INTEGER NOT NULL
);
insertFriend:
INSERT INTO FriendTable (
  user_id,               -- 好友唯一标识
  username,              -- 好友用户名
  nickname,              -- 好友昵称
  phone,                 -- 手机号码
  email,                 -- 邮箱地址
  avatar,                -- 头像URL
  background,            -- 背景图URL
  gender,                -- 性别（0/1/2）
  birthday,              -- 生日
  is_chat,               -- 是否正在聊天（0/1）
  signature,             -- 个人简介
  status,                -- 账号状态（0/1/2）
  is_online,             -- 是否在线
  last_login_time,       -- 最后登录时间（时间戳）
  last_login_ip,         -- 最后登录IP
  create_time,           -- 记录创建时间（时间戳）
  update_time            -- 记录更新时间（时间戳）
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);
removeFriend:
DELETE FROM FriendTable WHERE user_id = ?;

updateFriend:
UPDATE FriendTable
SET username = ?,              -- 更新用户名
    nickname = ?,              -- 更新昵称
    phone = ?,                 -- 更新手机号码
    email = ?,                 -- 更新邮箱
    avatar = ?,                -- 更新头像URL
    background = ?,            -- 更新背景图URL
    gender = ?,                -- 更新性别
    birthday = ?,              -- 更新生日
    signature = ?,             -- 更新个人简介
    status = ?,                -- 更新账号状态
    is_online = ?,             -- 更新在线状态
    last_login_time = ?,       -- 更新最后登录时间（时间戳）
    last_login_ip = ?,         -- 更新最后登录IP
    update_time = ?,           -- 更新记录的最后修改时间（时间戳）
    is_chat = ?                -- 更新聊天状态
WHERE user_id = ?;

updateFriendChatStatus:
UPDATE FriendTable SET is_chat = ? WHERE user_id = ?;
selectFrindByUserId:
SELECT * FROM FriendTable WHERE user_id = ?;

selectAllFriends:
SELECT * FROM FriendTable;

selectChattingFriends:
SELECT * FROM FriendTable WHERE is_chat = 1;

selectOnlineFriends:
SELECT * FROM FriendTable WHERE is_online = 1;
